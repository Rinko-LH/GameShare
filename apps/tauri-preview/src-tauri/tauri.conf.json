{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameShare Tauri Preview",
  "version": "0.1.0",
  "identifier": "com.gameshare.tauri-preview",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "GameShare · Tauri 技术预览",
      "width": 660,
      "height": 460,
      "minWidth": 480,
      "minHeight": 380
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
