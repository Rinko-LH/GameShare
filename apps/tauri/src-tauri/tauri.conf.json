{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameShare Tauri",
  "version": "1.7.0",
  "identifier": "com.gameshare.tauri",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node ../../node_modules/vite/bin/vite.js ../desktop --mode tauri --host 127.0.0.1 --port 1420",
    "frontendDist": "../../desktop/dist-tauri",
    "beforeBuildCommand": "node ../../node_modules/vite/bin/vite.js build ../desktop --mode tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "GameShare",
      "width": 1160,
      "height": 760,
      "minWidth": 710,
      "minHeight": 480,
      "decorations": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http: https: ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
